# Buzzcode server
DATABASE_URL=postgresql://localhost:5433/buzzcode
BUZZCODE_BIND=127.0.0.1:3100
BUZZCODE_APP_URL=http://localhost:1420
BUZZCODE_APP_ORIGIN=http://localhost:1420
BUZZCODE_OIDC_ISSUER=https://auth.example.com
BUZZCODE_OIDC_CLIENT_ID=buzzcode-desktop
BUZZCODE_OIDC_CLIENT_SECRET=replace-with-the-generated-rauthy-client-secret
BUZZCODE_OIDC_REDIRECT_URI=http://127.0.0.1:3100/api/auth/callback
BUZZCODE_SESSION_COOKIE_SECURE=false

# Desktop build
VITE_BUZZCODE_API_ORIGIN=http://127.0.0.1:3100
